<?xml version="1.0" encoding="UTF-8"?>
<pythonPanelDocument>
  <!-- This file contains definitions of Python interfaces and the
 interfaces menu.  It should not be hand-edited when it is being
 used by the application.  Note, that two definitions of the
 same interface or of the interfaces menu are not allowed
 in a single file. -->
  <interface name="hap::agent" label="Agent" icon="MISC_python" showNetworkNavigationBar="false" help_url="">
    <script><![CDATA[
# The ACP agent panel. onCreateInterface() must return a QWidget no matter
# what: if the panel's dependencies failed to install (an interrupted
# install) or the panel's own import fails for any other reason, the artist
# should see a readable cause and a hint, not an empty gray panel without a
# single word on it.

# A single panel can have several tabs, and each one holds its own widget.
# We tell them apart by the paneTab from kwargs — that's how SideFX's own
# panels do it (see LightLinker.pypanel).
_panels = {}


def _pane_key():
    # kwargs is a global that Houdini places into this script's scope.
    # It can't be referenced by name directly: calling from a different
    # context would raise NameError at the exact moment the panel is
    # already in trouble.
    pane = (globals().get("kwargs") or {}).get("paneTab")
    return id(pane) if pane is not None else None


def onCreateInterface():
    # Log first, before anything that can fail. If the import below blows up,
    # the reason must survive somewhere other than a Houdini console the
    # artist has probably already closed.
    try:
        from houdini_agent_panel import logbook

        logbook.setup()
    except Exception:  # noqa: BLE001 - no log is not a reason to lose the panel
        pass

    try:
        from houdini_agent_panel.ui.panel import AgentPanel
    except Exception as exc:  # noqa: BLE001 - the reason goes into the panel text
        _log_exception("panel import failed", exc)
        return _error_widget(exc)

    try:
        panel = AgentPanel()
    except Exception as exc:  # noqa: BLE001
        _log_exception("panel construction failed", exc)
        return _error_widget(exc)

    _panels[_pane_key()] = panel
    return panel


def onDestroyInterface():
    # Specifically the tab being closed. onDeactivateInterface doesn't work
    # for this: it fires every time the artist switches to a neighboring
    # tab in the pane, and tearing down on that would kill a live agent in
    # the middle of its work.
    panel = _panels.pop(_pane_key(), None)
    if panel is None:
        return
    shutdown = getattr(panel, "shutdown", None)
    if callable(shutdown):
        try:
            shutdown()
        except Exception as exc:  # noqa: BLE001
            print("[houdini-agent-panel] error while closing the panel: %r" % (exc,))


def _log_location():
    try:
        from houdini_agent_panel import logbook

        return str(logbook.log_path())
    except Exception:  # noqa: BLE001
        return "unavailable"


def _log_exception(what, exc):
    """Send a failure to the on-disk log, if the log is reachable at all."""
    try:
        import traceback

        from houdini_agent_panel import logbook

        logbook.logger("houdini_agent_panel.pypanel").error(
            "%s: %r\n%s", what, exc, traceback.format_exc()
        )
    except Exception:  # noqa: BLE001
        pass


def _error_widget(exc):
    try:
        from houdini_agent_panel.ui.qt import QtWidgets
    except Exception:  # noqa: BLE001 - last resort: Houdini's own shim
        from hutil.Qt import QtWidgets

    message = (
        "Houdini Agent Panel failed to start.\n\n"
        "%r\n\n"
        "Open a terminal and run this with the same Python you installed with:\n"
        "python -m houdini_agent_panel doctor\n\n"
        "Full log: %s"
    ) % (exc, _log_location())

    widget = QtWidgets.QWidget()
    layout = QtWidgets.QVBoxLayout(widget)
    label = QtWidgets.QLabel(message)
    label.setWordWrap(True)
    # The error text needs to be selectable and copyable into a bug report:
    # nobody's going to retype a traceback off the screen by hand.
    try:
        from houdini_agent_panel.ui.qt import Qt

        label.setTextInteractionFlags(Qt.TextSelectableByMouse)
    except Exception:  # noqa: BLE001
        pass
    layout.addWidget(label)
    layout.addStretch(1)
    return widget
]]></script>
    <includeInPaneTabMenu menu_position="500" create_separator="false"/>
    <help><![CDATA[]]></help>
  </interface>
</pythonPanelDocument>
